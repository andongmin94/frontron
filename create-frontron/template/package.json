{
  "name": "desktop-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Electron desktop app template with React and Vite",
  "productName": "__CREATE_APP_NAME__",
  "scripts": {
    "dev"          : "node scripts/tasks.mjs dev",
    "app"          : "node scripts/tasks.mjs app",
    "typecheck"    : "node scripts/tasks.mjs typecheck",
    "build"        : "node scripts/tasks.mjs build",
    "lint"         : "node scripts/tasks.mjs lint",
    "format"       : "node scripts/tasks.mjs format",
    "format:check" : "node scripts/tasks.mjs format:check"
  },
  "dependencies": {
    "@base-ui/react"             : "^1.9.0",
    "@fontsource-variable/geist" : "^5.3.0",
    "@shadcn/react"              : "^0.3.1",
    "@tailwindcss/vite"          : "^4.3.5",
    "class-variance-authority"   : "^0.7.1",
    "cmdk"                       : "^1.1.1",
    "cn"                         : "^0.5.2",
    "date-fns"                   : "^4.4.0",
    "embla-carousel-react"       : "^8.6.0",
    "input-otp"                  : "^1.5.0",
    "lucide-react"               : "^1.76.0",
    "react"                      : "^19.2.4",
    "react-day-picker"           : "^10.0.2",
    "react-dom"                  : "^19.2.4",
    "react-resizable-panels"     : "^4.24.1",
    "recharts"                   : "^3.8.0",
    "shiki"                      : "^4.6.0",
    "tailwindcss"                : "^4.3.5",
    "tw-animate-css"             : "^1.4.0"
  },
  "devDependencies": {
    "@types/node"          : "^25.5.0",
    "@types/react"         : "^19.2.14",
    "@types/react-dom"     : "^19.2.3",
    "@vitejs/plugin-react" : "^6.0.1",
    "electron"             : "^43.4.1",
    "electron-builder"     : "^26.0.12",
    "oxfmt"                : "^0.67.0",
    "oxlint"               : "^1.57.0",
    "typescript"           : "~6.0.2",
    "vite"                 : "^8.0.1"
  },
  "overrides": {
    "electron-builder": {
      "minimatch@>=9 <12": "^11.0.8"
    }
  },
  "main": "dist/electron/main.js",
  "build": {
    "appId": "__CREATE_APP_ID__",
    "productName": "__CREATE_APP_NAME__",
    "icon": "public/icon.png",
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "msi",
        "portable"
      ]
    },
    "msi": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    },
    "npmRebuild": false,
    "files": [
      "dist{,/**/*}",
      "public{,/**/*}",
      "!node_modules{,/**/*}"
    ],
    "directories": {
      "output": "output"
    }
  }
}
