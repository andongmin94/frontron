{
  "name": "desktop-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Electron desktop app template with React and Vite",
  "productName": "__CREATE_APP_NAME__",
  "scripts": {
    "dev"       : "node scripts/tasks.mjs dev",
    "app"       : "node scripts/tasks.mjs app",
    "typecheck" : "node scripts/tasks.mjs typecheck",
    "build"     : "node scripts/tasks.mjs build",
    "lint"         : "node scripts/tasks.mjs lint",
    "format"       : "node scripts/tasks.mjs format",
    "format:check" : "node scripts/tasks.mjs format:check"
  },
  "dependencies": {
    "react"     : "^19.2.4",
    "react-dom" : "^19.2.4"
  },
  "devDependencies": {
    "@types/node"          : "^25.5.0",
    "@types/react"         : "^19.2.14",
    "@types/react-dom"     : "^19.2.3",
    "@vitejs/plugin-react" : "^6.0.1",
    "electron"             : "^43.4.1",
    "electron-builder"     : "^26.0.12",
    "oxfmt"                : "^0.42.0",
    "oxlint"               : "^1.57.0",
    "typescript"           : "~6.0.2",
    "vite"                 : "^8.0.1"
  },
  "main": "dist/electron/main.js",
  "build": {
    "appId": "__CREATE_APP_ID__",
    "productName": "__CREATE_APP_NAME__",
    "icon": "public/logo.svg",
    "win": {
      "target": [
        "msi",
        "portable"
      ]
    },
    "msi": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    },
    "npmRebuild": false,
    "files": [
      "dist{,/**/*}",
      "public{,/**/*}",
      "!node_modules{,/**/*}"
    ],
    "directories": {
      "output": "output"
    }
  }
}
